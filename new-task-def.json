        },
        {
          "name": "APP_JWT_SECRET",
          "value": "Sanghi@9899983095"
        },
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "prod"
        },
        {
          "name": "SPRING_JPA_HIBERNATE_DDL_AUTO",
          "value": "update"
